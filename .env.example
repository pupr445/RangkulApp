# Salin file ini ke .env.local lalu isi dengan nilai dari dashboard Supabase-mu
# (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Diperlukan hanya jika kamu memakai operasi admin (Edge Functions, dsb).
# JANGAN pernah expose ini ke frontend / commit ke git.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opsional — aktifkan supaya email undangan anggota tim terkirim otomatis.
# Tanpa ini, undangan tetap tersimpan tapi kamu perlu kabari orangnya manual.
# Daftar gratis di https://resend.com, verifikasi domain pengirim di sana.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=RANGKUL <undangan@domainkamu.com>
